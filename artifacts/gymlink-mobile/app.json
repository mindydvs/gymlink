{
  "expo": {
    "name": "GymLink",
    "slug": "gymlink-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymlink-mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0D1A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymlink.mobile"
    },
    "android": {
      "package": "com.gymlink.mobile"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "GymLink needs access to your photo library to add recipe photos and videos.",
          "cameraPermission": "GymLink needs access to your camera to take photos and record videos for recipes.",
          "microphonePermission": "GymLink needs microphone access to record videos for recipes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
